{
  "name": "qualinutri",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm test && npm run build",
    "db:seed:generate": "node scripts/generate-supabase-seed.mjs",
    "db:push": "set -a; . ./.env.supabase-cli; set +a; supabase db push --linked",
    "db:push:dry": "set -a; . ./.env.supabase-cli; set +a; supabase db push --linked --dry-run",
    "db:lint": "set -a; . ./.env.supabase-cli; set +a; supabase db lint --linked --level warning",
    "db:types": "set -a; . ./.env.supabase-cli; set +a; supabase gen types typescript --linked --schema public > src/types/database.types.ts",
    "deploy": "npm run build && wrangler deploy",
    "preview:cloudflare": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "supabase": "^2.118.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
